{
    "$schema": "https://raw.githubusercontent.com/jetify-com/devbox/0.22.0/.schema/devbox.schema.json",
    "packages": [
        "rustup@latest",
        "libiconv@latest",
        "cmake@latest",
        "gnumake@latest",
        "pkg-config@latest"
    ],
    "env": {
        "RUSTUP_HOME": "$HOME/.rustup",
        "CARGO_HOME": "$HOME/.cargo",
        "RUST_LOG": "warn,transcendia=debug"
    },
    "shell": {
        "init_hook": [
            "export PATH=\"$CARGO_HOME/bin:$PATH\"",
            "rustup default stable",
            "if ! command -v cargo-packager >/dev/null 2>&1; then cargo install cargo-packager --locked; fi",
            "if ! command -v cargo-tauri >/dev/null 2>&1; then cargo install tauri-cli --version '^2' --locked; fi"
        ]
    }
}
